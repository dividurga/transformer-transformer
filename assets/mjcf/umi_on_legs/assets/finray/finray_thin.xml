<mujoco model="finray_finger">
    <compiler angle="radian" autolimits="true" />

    <default>
        <default class="visual">
            <geom type="mesh" contype="0" conaffinity="0" group="2" />
        </default>
        <default class="collision">
            <geom type="mesh" group="3" />
        </default>
        <default class="finray_collision">
            <geom condim="4" solimp="2 1 0.01" group="3" solref="0.01 1"
                friction="1 0.5 0.0005"
                priority="1" />
        </default>
    </default>

    <asset>
        <texture type="2d" name="texture"
            file="one_piece_wide_grasp_finray_finger_color.png" />
        <material name="finray_material" texture="texture" specular="0.5" shininess="0.0" />
        <mesh name="finger" file="one_piece_wide_grasp_finray_finger_decimated.obj"
            scale="0.76923076923 1.0 1.0" />
        <mesh name="finger_collider" file="collider.obj"
            scale="0.76923076923 1.0 1.0" />
    </asset>
    <worldbody>
        <body name="base">
            <!-- TODO measure real mass -->
            <inertial
                pos="0 0 0"
                mass="0.05"
                diaginertia="0.00068 0.00036 0.00091" />
            <geom mesh="finger" type="mesh" class="visual"
                mass="0.1" material="finray_material" />
            <geom mesh="finger_collider" type="mesh"
                class="finray_collision" rgba="1 0 0 1" />
        </body>
    </worldbody>
</mujoco>
    