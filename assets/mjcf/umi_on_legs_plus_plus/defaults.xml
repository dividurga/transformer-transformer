<mujoco model="defaults">
    <compiler angle="radian" autolimits="true" meshdir="../umi_on_legs/assets" />
    <default>
        <site group="0" />
        <geom size="0.012" group="3" friction="1.0" condim="1"
            density="14.11"
            type="capsule"
            shellinertia="true" rgba="0.95 0.95 0.95 1" />
        <default class="small_geom">
            <geom size="0.008" />
        </default>
        <!-- density is set based on an t-slot aluminum extrusion, 50cm at 0.545kg -->
        <default class="motor">
            <!-- estimated density of a QDD motor -->
            <geom shellinertia="false" type="cylinder" density="3000" rgba="0.26 0.39 0.85 1" />
            <default class="big_motor">
                <geom size="0.046 0.02" />
            </default>

            <default class="small_motor">
                <geom size="0.028 0.02" />
            </default>
        </default>
        <default class="TPU gripper">
            <geom size="0.00992679 0.01705057 0.05582194"
                pos="-5.76836167e-05 -1.64222581e-02  6.97321683e-02"
                quat="0.99765111 -0.06850003  0.          0.       "
                type="box" rgba="1.0 0.54 0.0  1" density="200" shellinertia="false" />
            <!-- density estimated from printed finger -->
        </default>
        <default class="camera">
            <geom rgba="0.1 0.1 0.1 1" />
        </default>
        <default class="battery">
            <geom size="0.05 0.03475 0.038" type="box" shellinertia="false" density="600"
                rgba="0.0 1.0 0.54 1" />
        </default>
        <default class="foot">
            <geom size="0.02" shellinertia="false"
                mass="0.1" condim="3" friction="0.8 0.02 0.01" type="sphere" />
        </default>

        <joint axis="0 1 0" damping="0.01" armature="0.001" frictionloss="0.05"
            solreflimit="0.005 1" />
        <default class="abduction">
            <joint axis="1 0 0" range="-1.0472 1.0472" />
            <position forcerange="-23.7 23.7" ctrlrange="-1.0472 1.0472" />
        </default>
        <default class="hip">
            <position forcerange="-23.7 23.7" ctrlrange="-1.5708 3.4907" />
            <default class="front_hip">
                <joint range="-1.5708 3.4907" />
            </default>
            <default class="back_hip">
                <joint range="-0.5236 4.5379" />
            </default>
        </default>
        <default class="knee">
            <position forcerange="-45.43 45.43" ctrlrange="-2.7227 -0.0" />
            <joint range="-2.7227 -0.0" />
        </default>
        <equality solref="0.005 1" />
    </default>
</mujoco>