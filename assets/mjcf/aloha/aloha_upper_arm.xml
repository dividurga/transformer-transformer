<mujoco model="aloha_upper_arm">
    <compiler angle="radian" meshdir="assets" autolimits="true" />

    <asset>
        <mesh file="custom_vx300s_3_upper_arm_part1.stl" />
        <mesh file="custom_vx300s_3_upper_arm_part2.stl" />
    </asset>

    <default>
        <default class="vx300s">
            <joint axis="0 1 0" actuatorfrcrange="-35 35" actuatorgravcomp="true" />
            <!-- group 4 means not a tracking site -->
            <site group="4" />
            <default class="shoulder">
                <joint range="-1.85005 1.25664"
                    actuatorfrcrange="-144 144" />
                <position ctrlrange="-1.85005 1.25664" kp="265" forcerange="-144 144" />
            </default>
            <default class="visual">
                <geom type="mesh" mass="0" group="2" contype="0" conaffinity="0" />
            </default>
            <default class="collision">
                <geom group="3" type="mesh" condim="6" friction="1 5e-3 5e-4" solref=".01 1" />
            </default>
        </default>
    </default>

    <worldbody>
        <body name="upper_arm_link" childclass="vx300s">
            <joint name="shoulder" class="shoulder" armature="0.395" frictionloss="2.0"
                damping="20.0" />
            <geom pos="0.0005 0 0.045" rgba='1 0 0 1' type="box" size="0.017 0.05 0.015"
                class="collision" mass="0.1" name="upper_arm_link_motor_housing" />
            <geom quat="1 0 0 1" class="visual" mesh="custom_vx300s_3_upper_arm_part1"
            />
            <geom type="box" size="0.01 0.02 0.103" pos="0 0 0.167" density="100"
                rgba="0.2 0.8 0.4 1" name="extension" class="collision" />
            <geom type="box" size="0.01 0.02 0.103" pos="0 0 0.167" density="100"
                name="extension_visual" class="visual" />
            <geom pos="0.033 0 0.3" rgba='1 0 0 1' type="box"
                size="0.04 0.05 0.015"
                class="collision" mass="0" name="upper_forearm_link_motor_housing" />
            <geom quat="1 0 0 1" class="visual" mesh="custom_vx300s_3_upper_arm_part2"
                name="upper_arm_connector" pos="0 0 0" />
            <site name="upper_forearm_mount" pos="0.05955 0 0.3" />
        </body>
    </worldbody>


    <custom>
        <numeric name="extension\geom\size\2\range\x+y" size='2' data='-0.05 0.20' />
        <text name="link_extension_size"
            data="extension\geom\size\2\range\x+y;extension_visual\geom\size\2\range\x+y" />

        <text name="shift_pos_with_extension_upper_arm"
            data="extension\geom\size\2\range\x+y;extension\geom\pos\2\range\x+y;extension_visual\geom\pos\2\range\x+y;upper_arm_connector\geom\pos\2\range\(y-x)*2;upper_forearm_mount\site\pos\2\range\0.3+y*2;upper_forearm_link_motor_housing\geom\pos\2\range\0.3+y*2" />


        <tuple name="actuators">
            <element objtype="joint" objname="shoulder" />
        </tuple>
    </custom>
</mujoco>