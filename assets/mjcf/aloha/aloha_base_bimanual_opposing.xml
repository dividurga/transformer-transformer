<mujoco model="aloha_base_bimanual_opposing">
    <compiler angle="radian" meshdir="assets" autolimits="true" />

    <asset>
        <mesh file="vx300s_1_base.stl" scale="0.001 0.001 0.001" />
    </asset>

    <default>
        <default class="vx300s">
            <site group="4" />
            <default class="visual">
                <geom type="mesh" mass="0" group="2" contype="0" conaffinity="0" />
            </default>
            <default class="collision">
                <geom group="3" type="mesh" condim="6" friction="1 5e-3 5e-4" solref=".01 1" />
            </default>
        </default>
    </default>

    <worldbody>
        <body name="base_link" childclass="vx300s" pos="0 0 0.0" euler="0 0 0">
            <geom type="box" size="0.35 0.10 0.005" pos="0 0 0.005" class="collision"
                rgba="0.4 0.4 0.4 1" mass="1.0" />
            <!-- left arm holder: rotated -pi/2 around z so the arm's local +x faces -y
                 (toward the right arm) -->
            <body name="left_arm_holder" pos="0 0.30 0" euler="0 0 -1.5707963267948966">
                <geom name="left_base_collision" type="cylinder" size="0.065 0.04"
                    pos="0 0 0.04" class="collision" rgba="1 0 0 1" mass="0.5" />
                <geom name="left_base_visual" quat="1 0 0 1" class="visual" mesh="vx300s_1_base"
                    pos="0 0 0" />
                <site name="left:shoulder_mount" pos="0 0 0.079" />
            </body>
            <!-- right arm holder: rotated +pi/2 around z so the arm's local +x faces +y
                 (toward the left arm) -->
            <body name="right_arm_holder" pos="0 -0.30 0" euler="0 0 1.5707963267948966">
                <geom name="right_base_collision" type="cylinder" size="0.065 0.04"
                    pos="0 0 0.04" class="collision" rgba="1 0 0 1" mass="0.5" />
                <geom name="right_base_visual" quat="1 0 0 1" class="visual" mesh="vx300s_1_base"
                    pos="0 0 0" />
                <site name="right:shoulder_mount" pos="0 0 0.079" />
            </body>
        </body>
    </worldbody>

    <custom>
        <numeric name="base_link\body\pos\0\range\y" size='2' data='-0.8 -0.1' />
        <numeric name="base_link\body\pos\1\range\y" size='2' data='-0.0 0.0' />
        <numeric name="base_link\body\pos\2\range\y" size='2' data='-0.1 0.1' />
    </custom>

</mujoco>
